<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(SpyBrowserPackageVersion)' == ''">
    <ProjectReference Include="../../src/SpyBrowser.Playwright/SpyBrowser.Playwright.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(SpyBrowserPackageVersion)' != ''">
    <PackageReference Include="SpyBrowser.Playwright" Version="$(SpyBrowserPackageVersion)" />
  </ItemGroup>
</Project>
