<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Playwright-compatible persistent browser runtime for SpyBrowser.</Description>
    <PackageId>SpyBrowser.Playwright</PackageId>
    <Authors>Rodrigo Jager</Authors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SpyBrowser.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <ProjectReference Include="..\SpyBrowser.Core\SpyBrowser.Core.csproj" />
    <ProjectReference Include="..\SpyBrowser.Cursory\SpyBrowser.Cursory.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
</Project>
